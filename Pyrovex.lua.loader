-- LOADING MESSAGES

local LoadingMessages = {
    {Time = 0, Text = "Initializing Pyrovex Hub..."},
    {Time = 1, Text = "Preparing loader interface..."},
    {Time = 2, Text = "Loading script collection..."},
    {Time = 3, Text = "Setting up components..."},
    {Time = 4, Text = "Almost ready..."}
}

for _,message in ipairs(LoadingMessages) do
    task.delay(message.Time,function()
        if not LoadingGui.Parent then return end

        Tween(LoadingStatus,{
            TextTransparency = 1
        },0.15)

        task.wait(0.15)

        if not LoadingGui.Parent then return end

        LoadingStatus.Text = message.Text

        Tween(LoadingStatus,{
            TextTransparency = 0
        },0.2)
    end)
end

-- EXACT 5 SECOND PROGRESS

local LoadingStart = os.clock()
local LoadingDuration = 5

local ProgressTween = Tween(
    Bar,
    {Size = UDim2.new(1,0,1,0)},
    LoadingDuration,
    Enum.EasingStyle.Linear
)

while os.clock() - LoadingStart < LoadingDuration do
    if not LoadingGui.Parent then return end

    local elapsed = os.clock() - LoadingStart
    local percentage = math.clamp(
        math.floor((elapsed / LoadingDuration) * 100),
        0,
        100
    )

    LoadingPercentage.Text = percentage.."%"

    task.wait(0.035)
end

LoadingPercentage.Text = "100%"
LoadingStatus.Text = "Pyrovex Hub is ready!"

Tween(LoadingStroke,{
    Color = C.Green,
    Transparency = 0
},0.2)

Tween(BarGradient,{
    Offset = Vector2.new(1,0)
},0.2)

task.wait(0.3)

-- LOADING EXIT

Tween(LoadingMain,{
    Position = UDim2.new(0.5,0,0,-100),
    BackgroundTransparency = 1
},0.65,Enum.EasingStyle.Quint,Enum.EasingDirection.In)

Tween(Settings,{TextTransparency = 1},0.3)
Tween(LoadingTitle,{TextTransparency = 1},0.3)
Tween(LoadingStatus,{TextTransparency = 1},0.3)
Tween(LoadingPercentage,{TextTransparency = 1},0.3)
Tween(BarBG,{BackgroundTransparency = 1},0.3)

task.wait(0.7)

LoadingGui:Destroy()

