local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(75, 65, 150)
Stroke.Thickness = 1
Stroke.Transparency = 0.15
Stroke.Parent = Main

-- SETTINGS EMOJI
local Settings = Instance.new("TextLabel")
Settings.Size = UDim2.new(0, 27, 0, 27)
Settings.Position = UDim2.new(0, 10, 0, 5)
Settings.BackgroundTransparency = 1
Settings.Text = "⚙️"
Settings.TextSize = 21
Settings.Font = Enum.Font.GothamBold
Settings.Parent = Main

-- ROTATION ANIMATION
task.spawn(function()
    while Settings.Parent do
        local Rotate = TweenService:Create(
            Settings,
            TweenInfo.new(
                1.5,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.InOut
            ),
            {Rotation = Settings.Rotation + 360}
        )

        Rotate:Play()
        Rotate.Completed:Wait()
    end
end)

-- STATUS TEXT
local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -52, 0, 19)
Status.Position = UDim2.new(0, 45, 0, 5)
Status.BackgroundTransparency = 1
Status.Text = "Waiting for game to load..."
Status.TextColor3 = Color3.fromRGB(235, 235, 255)
Status.TextSize = 11
Status.Font = Enum.Font.GothamSemibold
Status.TextXAlignment = Enum.TextXAlignment.Left
Status.Parent = Main

-- PROGRESS BACKGROUND
local BarBG = Instance.new("Frame")
BarBG.Size = UDim2.new(1, -55, 0, 5)
BarBG.Position = UDim2.new(0, 45, 0, 29)
BarBG.BackgroundColor3 = Color3.fromRGB(35, 30, 50)
BarBG.BorderSizePixel = 0
BarBG.ClipsDescendants = true
BarBG.Parent = Main

local BarCorner = Instance.new("UICorner")
BarCorner.CornerRadius = UDim.new(1, 0)
BarCorner.Parent = BarBG

-- PROGRESS BAR
local Bar = Instance.new("Frame")
Bar.Size = UDim2.new(0, 0, 1, 0)
Bar.BackgroundColor3 = Color3.fromRGB(40, 130, 255)
Bar.BorderSizePixel = 0
Bar.Parent = BarBG

local BarCorner2 = Instance.new("UICorner")
BarCorner2.CornerRadius = UDim.new(1, 0)
BarCorner2.Parent = Bar

-- BLUE x PURPLE x RED GRADIENT
local Gradient = Instance.new("UIGradient")
Gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 140, 255)),
    ColorSequenceKeypoint.new(0.45, Color3.fromRGB(100, 65, 255)),
    ColorSequenceKeypoint.new(0.75, Color3.fromRGB(170, 45, 150)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 55, 65))
})
Gradient.Parent = Bar

-- ANIMATION IN
TweenService:Create(
    Main,
    TweenInfo.new(
        0.65,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out
    ),
    {
        Position = UDim2.new(0.5, 0, 0, 12)
    }
):Play()

-- LOADING SEQUENCE
task.spawn(function()

    -- WAITING TEXT (2 SECONDS)
    task.wait(2)

    if not ScreenGui.Parent then return end

    -- SMOOTH TEXT CHANGE
    local FadeOut = TweenService:Create(
        Status,
        TweenInfo.new(0.2),
        {TextTransparency = 1}
    )

    FadeOut:Play()
    FadeOut.Completed:Wait()

    Status.Text = "Preparing Pyrovex Hub Loader..."

    TweenService:Create(
        Status,
        TweenInfo.new(0.3),
        {TextTransparency = 0}
    ):Play()

end)

-- 5 SECOND PROGRESS
local Progress = TweenService:Create(
    Bar,
    TweenInfo.new(
        5,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    ),
    {
        Size = UDim2.new(1, 0, 1, 0)
    }
)

Progress:Play()
Progress.Completed:Wait()

-- ANIMATION OUT
local Exit = TweenService:Create(
    Main,
    TweenInfo.new(
        0.6,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.In
    ),
    {
        Position = UDim2.new(0.5, 0, 0, -60),
        BackgroundTransparency = 1
    }
)

TweenService:Create(
    Settings,
    TweenInfo.new(0.3),
    {TextTransparency = 1}
):Play()

TweenService:Create(
    Status,
    TweenInfo.new(0.3),
    {TextTransparency = 1}
):Play()

TweenService:Create(
    BarBG,
    TweenInfo.new(0.3),
    {BackgroundTransparency = 1}
):Play()

Exit:Play()
Exit.Completed:Wait()

ScreenGui:Destroy()

--==================================================
-- PYROVEX HUB LOADING COMPLETE
