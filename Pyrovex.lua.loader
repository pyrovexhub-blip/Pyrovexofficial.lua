--==================================================
-- ANIMATION SETTINGS
--==================================================

local Animation = {
    Open = 0.45,
    Close = 0.30,
    Minimize = 0.28,
    Restore = 0.38,
    Hover = 0.18,
    Button = 0.12,
    Tab = 0.22
}

local function Tween(obj,properties,duration,style,direction)
    if not obj or not obj.Parent then
        return
    end

    local info = TweenInfo.new(
        duration or 0.25,
        style or Enum.EasingStyle.Quart,
        direction or Enum.EasingDirection.Out
    )

    local tween = TweenService:Create(obj,info,properties)
    tween:Play()

    return tween
end

--==================================================
-- HELPER FUNCTIONS
--==================================================

local function New(class,props,parent)
    local object = Instance.new(class)

    for property,value in pairs(props or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function Round(obj,radius)
    New("UICorner",{
        CornerRadius = UDim.new(0,radius)
    },obj)
end

local function Outline(obj,color,thickness,transparency)
    return New("UIStroke",{
        Color = color or C.Border,
        Thickness = thickness or 1,
        Transparency = transparency or 0
    },obj)
end

local function Gradient(obj,color1,color2,rotation)
    return New("UIGradient",{
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,color1),
            ColorSequenceKeypoint.new(1,color2)
        }),
        Rotation = rotation or 45
    },obj)
end

local function ButtonAnimation(button,normalColor,hoverColor)
    button.MouseEnter:Connect(function()
        Tween(button,{
            BackgroundColor3 = hoverColor
        },Animation.Hover)
    end)

    button.MouseLeave:Connect(function()
        Tween(button,{
            BackgroundColor3 = normalColor
        },Animation.Hover)
    end)

    button.MouseButton1Down:Connect(function()
        Tween(button,{
            Size = UDim2.new(
                button.Size.X.Scale,
                button.Size.X.Offset - 3,
                button.Size.Y.Scale,
                button.Size.Y.Offset - 2
            )
        },Animation.Button)
    end)

    button.MouseButton1Up:Connect(function()
        Tween(button,{
            Size = UDim2.new(
                button.Size.X.Scale,
                button.Size.X.Offset + 3,
                button.Size.Y.Scale,
                button.Size.Y.Offset + 2
            )
        },Animation.Button)
    end)
end

local function GetLoadstring(url)
    return 'loadstring(game:HttpGet("'..url..'"))()'
end

