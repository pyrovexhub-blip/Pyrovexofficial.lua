local Camera = workspace.CurrentCamera

local function UpdateScale(scaleObject)
    if not Camera then return end

    local viewport = Camera.ViewportSize

    local scale = math.min(
        viewport.X / 540,
        viewport.Y / 390,
        1
    )

    scaleObject.Scale = math.clamp(scale,0.68,1)
end

