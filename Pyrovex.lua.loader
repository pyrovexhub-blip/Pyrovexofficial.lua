--==================================================
-- SCRIPT CARD CREATOR
--==================================================

local function CreateScriptCard(scriptInfo,index)

    local Card = New("Frame",{
        Name = scriptInfo.Name,
        Size = UDim2.new(1,0,0,82),
        BackgroundColor3 = C.Card,
        BorderSizePixel = 0,
        LayoutOrder = index,
        BackgroundTransparency = 1
    },Content)

    Round(Card,12)

    local CardStroke = Outline(
        Card,
        C.Border,
        1
    )

    local CardScale = New("UIScale",{
        Scale = 0.96
    },Card)

    Tween(Card,{
        BackgroundTransparency = 0
    },0.25)

    Tween(CardScale,{
        Scale = 1
    },0.3)

    -- Left accent

    local CardAccent = New("Frame",{
        Size = UDim2.new(0,3,1,-24),
        Position = UDim2.fromOffset(0,12),
        BackgroundColor3 = C.Blue,
        BorderSizePixel = 0
    },Card)

    Round(CardAccent,5)

    Gradient(
        CardAccent,
        C.Blue,
        C.Purple,
        90
    )

    -- SCRIPT ICON
    -- P logo is only in the main title.

    local Icon = New("Frame",{
        Size = UDim2.fromOffset(43,43),
        Position = UDim2.fromOffset(12,19),
        BackgroundColor3 = Color3.fromRGB(35,43,70),
        BorderSizePixel = 0
    },Card)

    Round(Icon,11)

    Outline(
        Icon,
        C.Blue,
        1,
        0.55
    )

    New("TextLabel",{
        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1,
        Text = "📜",
        TextColor3 = C.White,
        TextSize = 23,
        Font = Enum.Font.GothamBold
    },Icon)

    -- SCRIPT NAME

    New("TextLabel",{
        Position = UDim2.fromOffset(67,11),
        Size = UDim2.new(1,-225,0,18),
        BackgroundTransparency = 1,
        Text = scriptInfo.Name,
        TextColor3 = C.White,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.GothamBlack
    },Card)

    -- SCRIPT DESCRIPTION

    New("TextLabel",{
        Position = UDim2.fromOffset(67,31),
        Size = UDim2.new(1,-225,0,16),
        BackgroundTransparency = 1,
        Text = scriptInfo.Subtitle,
        TextColor3 = C.Gray,
        TextSize = 7,
        TextWrapped = false,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.GothamMedium
    },Card)

    --==================================================
    -- BADGES
    --==================================================

    local HasHubBadges =
        scriptInfo.Name == "ADMIN BADGE"
        or scriptInfo.Name == "HOUSE OF THE LOCUST"
        or scriptInfo.Name == "ANTI AFK"
        or scriptInfo.Name == "PYROVEX DEBUGGER"
        or scriptInfo.Name == "PYROVEX HUB SHADER"
        or scriptInfo.Name == "TOKEN SPAWNER"

    local BadgeX = 67

    local function CreateBadge(text,color,width)

        local Badge = New("TextLabel",{
            Size = UDim2.fromOffset(width,13),
            Position = UDim2.fromOffset(BadgeX,56),
            BackgroundColor3 = color,
            BackgroundTransparency = 0.12,
            Text = text,
            TextColor3 = C.White,
            TextSize = 6,
            Font = Enum.Font.GothamBold,
            BorderSizePixel = 0
        },Card)

        Round(Badge,4)

        BadgeX = BadgeX + width + 5
    end

    if scriptInfo.Name == "CHILI HUB" then

        CreateBadge(
            "FEATURED",
            C.Purple,
            48
        )

    elseif HasHubBadges then

        CreateBadge(
            "FEATURED",
            C.Purple,
            48
        )

        CreateBadge(
            "BY PYROVEX HUB",
            Color3.fromRGB(54,65,110),
            75
        )

    end

    if scriptInfo.Name == "TOKEN SPAWNER" then

        CreateBadge(
            "KEY REQUIRED",
            C.Red,
            65
        )

    end

    --==================================================
    -- EXECUTE BUTTON
    --==================================================

    local Execute = New("TextButton",{
        Size = UDim2.fromOffset(69,27),
        Position = UDim2.new(1,-151,0,27),
        BackgroundColor3 = C.Blue,
        Text = "EXECUTE",
        TextColor3 = C.White,
        TextSize = 8,
        Font = Enum.Font.GothamBlack,
        AutoButtonColor = false,
        BorderSizePixel = 0
    },Card)

    Round(Execute,8)

    local ExecuteStroke = Outline(
        Execute,
        C.LightBlue,
        1,
        0.25
    )

    Gradient(
        Execute,
        C.Blue,
        C.Purple,
        0
    )

    ButtonAnimation(
        Execute,
        C.Blue,
        Color3.fromRGB(95,120,255)
    )

    --==================================================
    -- COPY BUTTON
    --==================================================

    local Copy = New("TextButton",{
        Size = UDim2.fromOffset(64,27),
        Position = UDim2.new(1,-75,0,27),
        BackgroundColor3 = C.CopyBackground,
        Text = "COPY",
        TextColor3 = C.White,
        TextSize = 8,
        Font = Enum.Font.GothamBlack,
        AutoButtonColor = false,
        BorderSizePixel = 0
    },Card)

    Round(Copy,8)

    Outline(
        Copy,
        C.CopyBorder,
        1
    )

    ButtonAnimation(
        Copy,
        C.CopyBackground,
        Color3.fromRGB(78,85,145)
    )

    --==================================================
    -- EXECUTE FUNCTION
    --==================================================

    local Executing = false

    Execute.MouseButton1Click:Connect(function()

        if Executing then
            return
        end

        Executing = true

        Execute.Text = "LOADING..."

        Tween(Execute,{
            BackgroundColor3 = Color3.fromRGB(80,91,180)
        },0.15)

        task.spawn(function()

            local success,err = pcall(function()

                local source = game:HttpGet(
                    scriptInfo.URL
                )

                local func = loadstring(source)

                if not func then
                    error("Unable to compile script")
                end

                func()

            end)

            if success then

                Execute.Text = "EXECUTED"

                Tween(Execute,{
                    BackgroundColor3 = C.Green
                },0.2)

            else

                Execute.Text = "FAILED"

                Tween(Execute,{
                    BackgroundColor3 = C.Red
                },0.2)

                warn(
                    "[PYROVEX LOADER] "
                    ..scriptInfo.Name
                    ..": "
                    ..tostring(err)
                )

            end

            task.wait(1.5)

            Execute.Text = "EXECUTE"

            Tween(Execute,{
                BackgroundColor3 = C.Blue
            },0.2)

            Executing = false

        end)

    end)

    --==================================================
    -- COPY FUNCTION
    --==================================================

    Copy.MouseButton1Click:Connect(function()

        local success = pcall(function()

            if not setclipboard then
                error("Clipboard is unsupported")
            end

            setclipboard(
                GetLoadstring(scriptInfo.URL)
            )

        end)

        if success then

            Copy.Text = "COPIED"

            Tween(Copy,{
                BackgroundColor3 = C.Green
            },0.2)

        else

            Copy.Text = "FAILED"

                        Tween(Copy,{
                    BackgroundColor3 = C.Red
                },0.2)

            end

        task.delay(1.5,function()

            if Copy and Copy.Parent then

                Copy.Text = "COPY"

                Tween(Copy,{
                    BackgroundColor3 = C.CopyBackground
                },0.2)

            end

        end)

    end)

    --==================================================
    -- CARD HOVER ANIMATION
    --==================================================

    Card.MouseEnter:Connect(function()

        Tween(Card,{
            BackgroundColor3 = C.CardHover
        },Animation.Hover)

        Tween(CardStroke,{
            Color = C.LightBlue
        },Animation.Hover)

    end)

    Card.MouseLeave:Connect(function()

        Tween(Card,{
            BackgroundColor3 = C.Card
        },Animation.Hover)

        Tween(CardStroke,{
            Color = C.Border
        },Animation.Hover)

    end)

end

--==================================================
-- TAB SYSTEM
--==================================================

local SelectedTab = nil
local TabButtons = {}

local function SelectTab(name)

    SelectedTab = name

    for tabName,tab in pairs(TabButtons) do

        local active = tabName == name

        Tween(tab,{
            BackgroundColor3 =
                active and C.Blue or C.Card
        },Animation.Tab)

        Tween(tab,{
            TextColor3 =
                active and C.White or C.Gray
        },Animation.Tab)

    end

    -- CLEAR OLD CARDS

    for _,child in ipairs(Content:GetChildren()) do

        if child:IsA("Frame") then
            child:Destroy()
        end

    end

    Content.CanvasPosition = Vector2.new(0,0)

    -- LOAD SELECTED SECTION

    local selectedScripts = {}

    if name == "STEAL AN EGG" then

        selectedScripts = Scripts

    elseif name == "GROW A GARDEN" then

        selectedScripts = GrowScripts

    elseif name == "HOUSE OF THE LOCUST" then

        selectedScripts = HouseScripts

    elseif name == "UNIVERSAL SCRIPTS" then

        selectedScripts = UniversalScripts

    end

    for index,scriptInfo in ipairs(selectedScripts) do
        CreateScriptCard(scriptInfo,index)
    end

end

--==================================================
-- CREATE TAB BUTTONS
--==================================================

for index,section in ipairs(Sections) do

    local Tab = New("TextButton",{
        Name = section.Name,
        Size = UDim2.fromOffset(section.Width,32),
        BackgroundColor3 = C.Card,
        Text = section.Name,
        TextColor3 = C.Gray,
        TextSize = 8,
        Font = Enum.Font.GothamBlack,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        LayoutOrder = index,
        ZIndex = 13
    },Tabs)

    Round(Tab,9)

    Outline(
        Tab,
        C.Border,
        1
    )

    TabButtons[section.Name] = Tab

    Tab.MouseButton1Click:Connect(function()
        SelectTab(section.Name)
    end)

    Tab.MouseEnter:Connect(function()

        if SelectedTab ~= section.Name then

            Tween(Tab,{
                BackgroundColor3 =
                    Color3.fromRGB(39,48,75)
            },Animation.Hover)

        end

    end)

    Tab.MouseLeave:Connect(function()

        if SelectedTab ~= section.Name then

            Tween(Tab,{
                BackgroundColor3 = C.Card
            },Animation.Hover)

        end

    end)

end

--==================================================
-- DEFAULT SELECTED TAB
--==================================================

SelectTab("STEAL AN EGG")

--==================================================
-- FLOATING MINIMIZE BUTTON
--==================================================

local FloatingButton = New("TextButton",{
    Name = "FloatingButton",
    Size = UDim2.fromOffset(49,49),
    Position = UDim2.new(0,20,0.5,-24),
    BackgroundColor3 = C.Blue,
    Text = "📜",
    TextColor3 = C.White,
    TextSize = 23,
    Font = Enum.Font.GothamBold,
    AutoButtonColor = false,
    BorderSizePixel = 0,
    Visible = false,
    Active = true,
    ZIndex = 100
},Screen)

Round(FloatingButton,100)

Outline(
    FloatingButton,
    C.LightBlue,
    1.5
)

Gradient(
    FloatingButton,
    C.Blue,
    C.Purple,
    45
)

local FloatingScale = New("UIScale",{
    Scale = 1
},FloatingButton)

FloatingButton.MouseEnter:Connect(function()

    Tween(FloatingScale,{
        Scale = 1.12
    },0.18)

end)

FloatingButton.MouseLeave:Connect(function()

    Tween(FloatingScale,{
        Scale = 1
    },0.18)

end)

--==================================================
-- OPENING ANIMATION
--==================================================

Main.Visible = true
Main.BackgroundTransparency = 1

Tween(Main,{
    BackgroundTransparency = 0
},Animation.Open)

Tween(MainScale,{
    Scale = 1
},Animation.Open)

--==================================================
-- MINIMIZE ANIMATION
--==================================================

local IsAnimating = false

Minimize.MouseButton1Click:Connect(function()

    if IsAnimating then
        return
    end

    IsAnimating = true

    Tween(MainScale,{
        Scale = 0.82
    },Animation.Minimize)

    local fade = Tween(Main,{
        BackgroundTransparency = 1
    },Animation.Minimize)

    fade.Completed:Wait()

    if not Screen.Parent then
        return
    end

    Main.Visible = false
    Main.BackgroundTransparency = 0
    MainScale.Scale = 0.82

    FloatingButton.Visible = true
    FloatingScale.Scale = 0.65

    Tween(FloatingScale,{
        Scale = 1
    },Animation.Restore)

    IsAnimating = false

end)

--==================================================
-- RESTORE ANIMATION
--==================================================

FloatingButton.MouseButton1Click:Connect(function()

    if IsAnimating then
        return
    end

    IsAnimating = true

    FloatingButton.Visible = false

    Main.Visible = true
    Main.BackgroundTransparency = 1
    MainScale.Scale = 0.85

    Tween(Main,{
        BackgroundTransparency = 0
    },Animation.Restore)

    local restore = Tween(MainScale,{
        Scale = 1
    },Animation.Restore)

    restore.Completed:Wait()

    IsAnimating = false

end)

--==================================================
-- CLOSE ANIMATION
--==================================================

local Closing = false

Close.MouseButton1Click:Connect(function()

    if Closing then
        return
    end

    Closing = true
    IsAnimating = true

    local fade = Tween(Main,{
        BackgroundTransparency = 1
    },Animation.Close)

    Tween(MainScale,{
        Scale = 0.85
    },Animation.Close)

    fade.Completed:Wait()

    if Screen and Screen.Parent then
        Screen:Destroy()
    end

end)

--==================================================
-- MAIN WINDOW DRAGGING
--==================================================

local Dragging = false
local DragStart = nil
local StartPosition = nil

Header.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        DragStart = input.Position
        StartPosition = Main.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end

        end)

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if Dragging then

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - DragStart

            Main.Position = UDim2.new(
                StartPosition.X.Scale,
                StartPosition.X.Offset + delta.X,
                StartPosition.Y.Scale,
                StartPosition.Y.Offset + delta.Y
            )

        end

    end

end)

--==================================================
-- FLOATING BUTTON DRAGGING
--==================================================

local FloatingDragging = false
local FloatingDragStart = nil
local FloatingStartPosition = nil

FloatingButton.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        FloatingDragging = true
        FloatingDragStart = input.Position
        FloatingStartPosition = FloatingButton.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                FloatingDragging = false
            end

        end)

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if FloatingDragging then

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - FloatingDragStart

            FloatingButton.Position = UDim2.new(
                FloatingStartPosition.X.Scale,
                FloatingStartPosition.X.Offset + delta.X,
                FloatingStartPosition.Y.Scale,
                FloatingStartPosition.Y.Offset + delta.Y
            )

        end

    end

end)

