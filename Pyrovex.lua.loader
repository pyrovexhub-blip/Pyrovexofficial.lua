    Name = "DiscordCopy",
    Size = UDim2.fromOffset(150,20),
    Position = UDim2.fromOffset(258,17),
    BackgroundTransparency = 1,
    Text = "Click here to Copy discord Link",
    TextColor3 = C.LightBlue,
