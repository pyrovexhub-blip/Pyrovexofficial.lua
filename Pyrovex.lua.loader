--==================================================
-- SCRIPT CARD CREATOR
--==================================================

local function CreateScriptCard(scriptInfo,index)

    local Card = New("Frame",{
        Name = scriptInfo.Name,
        Size = UDim2.new(1,0,0,82),
        BackgroundColor3 = C.Card,
        BorderSizePixel = 0,
        LayoutOrder = index,
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 6
    },Content)

    Round(Card,12)

    local CardStroke = Outline(Card,C.Border,1)

    local CardScale = New("UIScale",{
        Scale = 0.96
    },Card)

    -- CARD ACCENT

    local CardAccent = New("Frame",{
        Size = UDim2.new(0,3,1,-24),
        Position = UDim2.fromOffset(5,12),
        BackgroundColor3 = C.Blue,
        BorderSizePixel = 0,
        ZIndex = 7
    },Card)

    Round(CardAccent,5)
    Gradient(CardAccent,C.Blue,C.Purple,90)

    -- SCRIPT ICON

    local Icon = New("Frame",{
        Size = UDim2.fromOffset(44,44),
        Position = UDim2.fromOffset(13,19),
        BackgroundColor3 = Color3.fromRGB(32,44,72),
        BorderSizePixel = 0,
        ZIndex = 7
    },Card)

    Round(Icon,11)
    Gradient(Icon,Color3.fromRGB(44,75,120),Color3.fromRGB(54,39,100),45)
    Outline(Icon,C.Blue,1,0.45)

    New("TextLabel",{
        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1,
        Text = "📜",
        TextColor3 = C.White,
        TextSize = 23,
        Font = Enum.Font.GothamBold,
        ZIndex = 8
    },Icon)

    -- SCRIPT NAME

    New("TextLabel",{
        Position = UDim2.fromOffset(68,10),
        Size = UDim2.new(1,-225,0,19),
        BackgroundTransparency = 1,
        Text = scriptInfo.Name,
        TextColor3 = C.White,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.GothamBlack,
        ZIndex = 7
    },Card)

    -- SCRIPT DESCRIPTION

    New("TextLabel",{
        Position = UDim2.fromOffset(68,31),
        Size = UDim2.new(1,-225,0,16),
        BackgroundTransparency = 1,
        Text = scriptInfo.Subtitle,
        TextColor3 = C.Gray,
        TextSize = 7,
        TextWrapped = false,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.GothamMedium,
        ZIndex = 7
    },Card)

    -- BADGES

    local HasHubBadges =
        scriptInfo.Name == "ADMIN BADGE"
        or scriptInfo.Name == "HOUSE OF THE LOCUST"
        or scriptInfo.Name == "ANTI AFK"
        or scriptInfo.Name == "PYROVEX DEBUGGER"
        or scriptInfo.Name == "PYROVEX HUB SHADER"
        or scriptInfo.Name == "TOKEN SPAWNER"

    local BadgeX = 68

    local function CreateBadge(text,color,width)

        local Badge = New("TextLabel",{
            Size = UDim2.fromOffset(width,13),
            Position = UDim2.fromOffset(BadgeX,56),
            BackgroundColor3 = color,
            BackgroundTransparency = 0.12,
            Text = text,
            TextColor3 = C.White,
            TextSize = 6,
            Font = Enum.Font.GothamBold,
            BorderSizePixel = 0,
            ZIndex = 8
        },Card)

        Round(Badge,5)

        BadgeX = BadgeX + width + 5

    end

    if scriptInfo.Name == "CHILI HUB" then

        CreateBadge("FEATURED",C.Purple,48)

    elseif HasHubBadges then

        CreateBadge("FEATURED",C.Purple,48)
        CreateBadge("BY PYROVEX HUB",Color3.fromRGB(54,65,110),75)

    end

    if scriptInfo.Name == "TOKEN SPAWNER" then
        CreateBadge("KEY REQUIRED",C.Red,65)
    end

    -- EXECUTE BUTTON

    local Execute = New("TextButton",{
        Name = "ExecuteButton",
        Size = UDim2.fromOffset(69,28),
        Position = UDim2.new(1,-151,0,27),
        BackgroundColor3 = C.Blue,
        Text = "EXECUTE",
        TextColor3 = C.White,
        TextSize = 8,
        Font = Enum.Font.GothamBlack,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 9
    },Card)

    Round(Execute,8)
    Outline(Execute,C.LightBlue,1,0.25)
    Gradient(Execute,C.Blue,C.Purple,0)

    ButtonAnimation(
        Execute,
        C.Blue,
        Color3.fromRGB(95,120,255)
    )

    -- COPY BUTTON

    local Copy = New("TextButton",{
        Name = "CopyButton",
        Size = UDim2.fromOffset(64,28),
        Position = UDim2.new(1,-75,0,27),
        BackgroundColor3 = C.CopyBackground,
        Text = "COPY",
        TextColor3 = C.White,
        TextSize = 8,
        Font = Enum.Font.GothamBlack,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 9
    },Card)

    Round(Copy,8)
    Outline(Copy,C.CopyBorder,1)

    ButtonAnimation(
        Copy,
        C.CopyBackground,
        Color3.fromRGB(78,85,145)
    )

    -- EXECUTE FUNCTION

    local Executing = false

    Execute.MouseButton1Click:Connect(function()

        if Executing then return end

        Executing = true
        Execute.Text = "LOADING..."

        task.spawn(function()

            local success,err = pcall(function()

                local source = game:HttpGet(scriptInfo.URL)
                local func = loadstring(source)

                if not func then
                    error("Unable to compile script")
                end

                func()

            end)

            if success then

                Execute.Text = "EXECUTED"

            else

                Execute.Text = "FAILED"

                warn(
                    "[PYROVEX LOADER] "
                    ..scriptInfo.Name
                    ..": "
                    ..tostring(err)
                )

            end

            task.wait(1.5)

            if Execute and Execute.Parent then
                Execute.Text = "EXECUTE"
            end

            Executing = false

        end)

    end)

    -- COPY FUNCTION

    Copy.MouseButton1Click:Connect(function()

        local success,err = pcall(function()

            if not setclipboard then
                error("Clipboard is unsupported")
            end

            setclipboard(GetLoadstring(scriptInfo.URL))

        end)

        if success then

            Copy.Text = "COPIED"

        else

            Copy.Text = "FAILED"

            warn(
                "[PYROVEX LOADER] COPY ERROR: "
                ..tostring(err)
            )

        end

        task.delay(1.5,function()

            if Copy and Copy.Parent then
                Copy.Text = "COPY"
            end

        end)

    end)

    -- CARD HOVER ANIMATION

    Card.MouseEnter:Connect(function()

        Tween(Card,{
            BackgroundColor3 = C.CardHover
        },Animation.Hover)

        Tween(CardStroke,{
            Color = C.LightBlue,
            Transparency = 0.1
        },Animation.Hover)

        Tween(CardScale,{
            Scale = 1
        },Animation.Hover)

        Tween(CardAccent,{
            Size = UDim2.new(0,4,1,-12),
            Position = UDim2.fromOffset(5,6)
        },Animation.Hover)

    end)

    Card.MouseLeave:Connect(function()

        Tween(Card,{
            BackgroundColor3 = C.Card
        },Animation.Hover)

        Tween(CardStroke,{
            Color = C.Border,
            Transparency = 0
        },Animation.Hover)

        Tween(CardScale,{
            Scale = 0.96
        },Animation.Hover)

        Tween(CardAccent,{
            Size = UDim2.new(0,3,1,-24),
            Position = UDim2.fromOffset(5,12)
        },Animation.Hover)

    end)

    -- CARD ENTRANCE

    Tween(Card,{
        BackgroundTransparency = 0
    },Animation.Card)

    Tween(CardScale,{
        Scale = 1
    },Animation.Card,Enum.EasingStyle.Back)

end

--==================================================
-- TAB SYSTEM
--==================================================

local SelectedTab = nil
local TabButtons = {}

local function SelectTab(name)

    SelectedTab = name

    for tabName,tab in pairs(TabButtons) do

        local active = tabName == name

        Tween(tab,{
            BackgroundColor3 = active and C.Blue or C.Card,
            TextColor3 = active and C.White or C.Gray
        },Animation.Tab)

        local stroke = tab:FindFirstChild("TabStroke")

        if stroke then

            Tween(stroke,{
                Color = active and C.LightBlue or C.Border,
                Transparency = active and 0.1 or 0
            },Animation.Tab)

        end

        local indicator = tab:FindFirstChild("Indicator")

        if indicator then

            Tween(indicator,{
                Size = active
                    and UDim2.new(0.55,0,0,2)
                    or UDim2.new(0,0,0,2),

                BackgroundTransparency = active and 0 or 1
            },Animation.Tab)

        end

    end

    -- CLEAR OLD CONTENT

    for _,child in ipairs(Content:GetChildren()) do

        if child:IsA("Frame") then
            child:Destroy()
        end

    end

    Content.CanvasPosition = Vector2.new(0,0)

    -- SELECT SCRIPTS

    local selectedScripts = {}

    if name == "STEAL AN EGG" then

        selectedScripts = Scripts

    elseif name == "GROW A GARDEN" then

        selectedScripts = GrowScripts

    elseif name == "HOUSE OF THE LOCUST" then

        selectedScripts = HouseScripts

    elseif name == "UNIVERSAL SCRIPTS" then

        selectedScripts = UniversalScripts

    end

    -- CREATE CARDS

    for index,scriptInfo in ipairs(selectedScripts) do
        CreateScriptCard(scriptInfo,index)
    end

end

--==================================================
-- CREATE TAB BUTTONS
--==================================================

for index,section in ipairs(Sections) do

    local Tab = New("TextButton",{
        Name = section.Name,
        Size = UDim2.fromOffset(section.Width,33),
        BackgroundColor3 = C.Card,
        Text = section.Name,
        TextColor3 = C.Gray,
        TextSize = 8,
        Font = Enum.Font.GothamBlack,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        LayoutOrder = index,
        ClipsDescendants = true,
        ZIndex = 7
    },Tabs)

    Round(Tab,9)

    local TabStroke = Outline(Tab,C.Border,1)
    TabStroke.Name = "TabStroke"

    local Indicator = New("Frame",{
        Name = "Indicator",
        Size = UDim2.new(0,0,0,2),
        Position = UDim2.new(0.225,0,1,-4),
        BackgroundColor3 = C.White,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 9
    },Tab)

    Round(Indicator,5)

    TabButtons[section.Name] = Tab

    Tab.MouseButton1Click:Connect(function()
        SelectTab(section.Name)
    end)

    Tab.MouseEnter:Connect(function()

        if SelectedTab ~= section.Name then

            Tween(Tab,{
                BackgroundColor3 = Color3.fromRGB(38,51,79)
            },Animation.Hover)

        end

    end)

    Tab.MouseLeave:Connect(function()

        if SelectedTab ~= section.Name then

            Tween(Tab,{
                BackgroundColor3 = C.Card
            },Animation.Hover)

        end

    end)

end

--==================================================
-- FLOATING MINIMIZE BUTTON
--==================================================

local FloatingButton = New("TextButton",{
    Name = "FloatingButton",
    Size = UDim2.fromOffset(50,50),
    Position = UDim2.new(0,20,0.5,-25),
    BackgroundColor3 = C.Blue,
    Text = "P",
    TextColor3 = C.White,
    TextSize = 25,
    Font = Enum.Font.GothamBlack,
    AutoButtonColor = false,
    BorderSizePixel = 0,
    Visible = false,
    Active = true,
    ZIndex = 100
},Screen)

Round(FloatingButton,100)
Outline(FloatingButton,C.LightBlue,1.5)
Gradient(FloatingButton,C.LightBlue,C.Purple,45)

local FloatingScale = New("UIScale",{
    Scale = 0.7
},FloatingButton)

FloatingButton.MouseEnter:Connect(function()

    Tween(FloatingScale,{
        Scale = 1.12
    },0.18,Enum.EasingStyle.Back)

end)

FloatingButton.MouseLeave:Connect(function()

    Tween(FloatingScale,{
        Scale = 1
    },0.18)

end)

--==================================================
-- OPENING ANIMATION
--==================================================

Main.BackgroundTransparency = 1
Outer.BackgroundTransparency = 1

Tween(Outer,{
    BackgroundTransparency = 0
},Animation.Open)

Tween(Main,{
    BackgroundTransparency = 0
},Animation.Open)

Tween(
    MainScale,
    {Scale = 1},
    Animation.Open,
    Enum.EasingStyle.Back
)

--==================================================
-- MINIMIZE / RESTORE
--==================================================

local IsAnimating = false
local Closing = false

Minimize.MouseButton1Click:Connect(function()

    if IsAnimating or Closing then return end

    IsAnimating = true

    Tween(
        MainScale,
        {Scale = 0.78},
        Animation.Minimize,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.In
    )

    local fade = Tween(Main,{
        BackgroundTransparency = 1
    },Animation.Minimize)

    Tween(Outer,{
        BackgroundTransparency = 1
    },Animation.Minimize)

    fade.Completed:Wait()

    if not Screen.Parent then return end

    Main.Visible = false
    Outer.Visible = false

    FloatingButton.Visible = true
    FloatingScale.Scale = 0.65

    Tween(
        FloatingScale,
        {Scale = 1},
        Animation.Restore,
        Enum.EasingStyle.Back
    )

    IsAnimating = false

end)

FloatingButton.MouseButton1Click:Connect(function()

    if IsAnimating or Closing then return end

    IsAnimating = true

    Tween(FloatingScale,{
        Scale = 0.65
    },0.12)

    task.wait(0.12)

    if not Screen.Parent then return end

    FloatingButton.Visible = false

    Outer.Visible = true
    Main.Visible = true

    Main.BackgroundTransparency = 1
    Outer.BackgroundTransparency = 1
    MainScale.Scale = 0.78

    Tween(Outer,{
        BackgroundTransparency = 0
    },Animation.Restore)

    Tween(Main,{
        BackgroundTransparency = 0
    },Animation.Restore)

    local restore = Tween(
        MainScale,
        {Scale = 1},
        Animation.Restore,
        Enum.EasingStyle.Back
    )

    restore.Completed:Wait()

    IsAnimating = false

end)

--==================================================
-- CLOSE ANIMATION
--==================================================

Close.MouseButton1Click:Connect(function()

    if Closing or IsAnimating then return end

    Closing = true
    IsAnimating = true

    Tween(
        MainScale,
        {Scale = 0.82},
        Animation.Close,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.In
    )

    local fade = Tween(Main,{
        BackgroundTransparency = 1
    },Animation.Close)

    Tween(Outer,{
        BackgroundTransparency = 1
    },Animation.Close)

    fade.Completed:Wait()

    if Screen and Screen.Parent then
        Screen:Destroy()
    end

end)

--==================================================
-- MAIN WINDOW DRAGGING
--==================================================

local Dragging = false
local DragStart = nil
local StartPosition = nil
local DragInput = nil

Header.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        DragStart = input.Position
        StartPosition = Outer.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end

        end)

    end

end)

Header.InputChanged:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        DragInput = input

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if Dragging and (
        input == DragInput
        or input.UserInputType == Enum.UserInputType.Touch
    ) then

        local delta = input.Position - DragStart

        Outer.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + delta.Y
        )

    end

end)

--==================================================
-- FLOATING BUTTON DRAGGING
--==================================================

local FloatingDragging = false
local FloatingDragStart = nil
local FloatingStartPosition = nil
local FloatingDragInput = nil

FloatingButton.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        FloatingDragging = true
        FloatingDragStart = input.Position
        FloatingStartPosition = FloatingButton.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                FloatingDragging = false
            end

        end)

    end

end)

FloatingButton.InputChanged:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        FloatingDragInput = input

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if FloatingDragging and (
        input == FloatingDragInput
        or input.UserInputType == Enum.UserInputType.Touch
    ) then

        local delta = input.Position - FloatingDragStart

        FloatingButton.Position = UDim2.new(
            FloatingStartPosition.X.Scale,
            FloatingStartPosition.X.Offset + delta.X,
            FloatingStartPosition.Y.Scale,
            FloatingStartPosition.Y.Offset + delta.Y
        )

    end

end)

--==================================================
-- INITIALIZE
--==================================================

SelectTab("STEAL AN EGG")

print("[PYROVEX LOADER] Successfully loaded!")
